# Copia este archivo como "secrets.properties" y escribe las contraseñas reales.
# secrets.properties está en .gitignore: nunca se sube al repositorio.
# Spring lee este archivo en ISO-8859-1: si una contraseña tiene ñ, tildes o €, hay que
# escribir esos caracteres con su código Unicode (por ejemplo, ñ = \u00f1, á = \u00e1).
spring.datasource.password=CAMBIAR

# Administrador que se crea al arrancar si no existe ninguno (mínimo 8 caracteres).
# Después del primer arranque se puede borrar esta línea.
horneo.admin.username=admin
horneo.admin.password=CAMBIAR

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Para generar una:
#   openssl rand -base64 32
horneo.jwt.secreto=CAMBIAR
