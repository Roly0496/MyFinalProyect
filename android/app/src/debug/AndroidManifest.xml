<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en la versión de desarrollo: desde Android 17 hace falta este permiso para conectar con
     la red local, donde se ejecuta el backend durante el desarrollo y la demo (10.0.2.2 desde el
     emulador). La versión de producción usará un servidor en Internet y no lo necesita.
     Se concede una vez: Ajustes > Aplicaciones > Horneo > Permisos > Dispositivos cercanos. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

</manifest>
