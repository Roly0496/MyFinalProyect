<?xml version="1.0" encoding="utf-8"?>
<!-- Por defecto Android solo permite HTTPS. Se permite HTTP únicamente hacia el ordenador
     de desarrollo visto desde el emulador (10.0.2.2), donde se ejecuta el backend en local. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
